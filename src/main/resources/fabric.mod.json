{
  "schemaVersion": 1,
  "id": "team_locator",
  "version": "1.2.0",
  "name": "Team Locator",
  "description": "Share your position with friends through an encrypted channel (HiveMQ). Shows their heads as waypoints with distance, plus a small team list. Settings: key J, /tl config or Mod Menu.",
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.example.teamlocator.TeamLocatorClient"
    ],
    "modmenu": [
      "dev.example.teamlocator.ModMenuIntegration"
    ]
  },
  "depends": {
    "fabricloader": ">=0.18.1",
    "minecraft": "1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  },
  "suggests": {
    "modmenu": "*"
  },
  "mixins": [
    "team_locator.mixins.json"
  ]
}